[global]
    font = JetBrains Mono Nerd Font 10
    format = "<b>%s</b>\b%b"

    # Appearance
    width = 300
    height = 100
    origin = top-right
    offset = 10x40
    notification_limit = 5
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    frame_color = "#cba6f7"
    separator_color = frame

    # Icons
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    # Behavior
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    timeout = 10

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
